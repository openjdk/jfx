<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx</artifactId>
        <version>28-ea</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>javafx-graphics</artifactId>
    <name>javafx-graphics</name>
    <description>JavaFX graphics module (javafx.graphics)</description>

    <properties>
        <jfx.graphics.modulepath>${project.build.outputDirectory}${path.separator}${jfx.root}/modules/javafx.base/target/classes</jfx.graphics.modulepath>
        <jfx.graphics.gensrc>${project.build.directory}/gensrc</jfx.graphics.gensrc>
        <!-- Gradle parity: the JSLC hardware backends are platform specific.
             Gradle emitted -d3d on Windows, -mtl on macOS, and -es2 on Linux
             or whenever INCLUDE_ES2 was set. Linux therefore always gets -es2,
             which is what this default provides; it also covers any other OS.
             The jsl-backends-* profiles below override it for Windows and macOS. -->
        <jfx.jsl.backends>-es2</jfx.jsl.backends>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Build-time only: JSL shader compiler and its ANTLR runtime -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-jslc</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Shim classes on the test classpath; at runtime the shim modules from the
             upgrade module path own these packages (classpath copies are ignored). -->
        <testResources>
            <testResource>
                <directory>${jfx.shims.base}</directory>
                <excludes>
                    <exclude>module-info.class</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>${jfx.shims.graphics}</directory>
                <excludes>
                    <exclude>module-info.class</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>--module-version</arg>
                        <arg>${jfx.release.version.short}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Generate and compile the Decora/Prism JSL shaders. This mirrors the
                             Gradle addJSL/compileFullJava pipeline:
                             1. compile the JSL shader compilers against pass-one classes
                             2. run GenAllDecoraShaders / CompileJSL to emit .java/.hlsl/.frag
                             3. recompile the whole module (main + generated) as a second pass,
                                emitting the JNI headers used by the native build -->
                        <id>jsl-codegen</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/jsl-compilers/decora"/>
                                <mkdir dir="${project.build.directory}/jsl-compilers/prism"/>
                                <mkdir dir="${jfx.graphics.gensrc}/jsl-decora"/>
                                <mkdir dir="${jfx.graphics.gensrc}/jsl-prism"/>
                                <mkdir dir="${jfx.graphics.gensrc}/headers"/>
                                <!-- The JSLC MSL backend writes the Metal uniform-struct headers
                                     here but does not create the directory itself (Gradle created
                                     it in the generateShaders task) -->
                                <mkdir dir="${jfx.graphics.gensrc}/mtl-headers"/>

                                <javac destdir="${project.build.directory}/jsl-compilers/decora"
                                       includeantruntime="false" encoding="UTF-8" debug="true"
                                       release="${jfx.jdk.target.version}" fork="true">
                                    <src path="${project.basedir}/src/main/jsl-decora"/>
                                    <classpath refid="maven.compile.classpath"/>
                                    <compilerarg value="-implicit:none"/>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.graphics.modulepath}"/>
                                    <compilerarg value="--add-modules=javafx.graphics"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.scenario.effect=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.scenario.effect.light=ALL-UNNAMED"/>
                                    <compilerarg value="--add-exports=javafx.graphics/com.sun.scenario.effect.impl.state=ALL-UNNAMED"/>
                                </javac>

                                <java classname="GenAllDecoraShaders" fork="true" failonerror="true"
                                      dir="${project.basedir}">
                                    <classpath>
                                        <path refid="maven.compile.classpath"/>
                                        <pathelement location="${project.basedir}/src/jslc/resources"/>
                                        <pathelement location="${project.build.directory}/jsl-compilers/decora"/>
                                    </classpath>
                                    <jvmarg value="--module-path=${jfx.graphics.modulepath}"/>
                                    <jvmarg value="--add-modules=javafx.graphics"/>
                                    <jvmarg value="--add-exports=javafx.graphics/com.sun.scenario.effect=ALL-UNNAMED"/>
                                    <jvmarg value="--add-exports=javafx.graphics/com.sun.scenario.effect.light=ALL-UNNAMED"/>
                                    <jvmarg value="--add-exports=javafx.graphics/com.sun.scenario.effect.impl.state=ALL-UNNAMED"/>
                                    <arg value="-i"/>
                                    <arg value="${project.basedir}/src/main/jsl-decora"/>
                                    <arg value="-o"/>
                                    <arg value="${jfx.graphics.gensrc}/jsl-decora"/>
                                    <arg value="-t"/>
                                    <arg value="-pkg"/>
                                    <arg value="com/sun/scenario/effect"/>
                                    <arg line="${jfx.jsl.backends}"/>
                                    <!-- placeholders: GenAllDecoraShaders.java drops the last two args and sets each shader's output types -->
                                    <arg value="-all"/>
                                    <arg value="GenAllDecoraShaders"/>
                                </java>

                                <javac destdir="${project.build.directory}/jsl-compilers/prism"
                                       includeantruntime="false" encoding="UTF-8" debug="true"
                                       release="${jfx.jdk.target.version}" fork="true">
                                    <src path="${project.basedir}/src/main/jsl-prism"/>
                                    <classpath refid="maven.compile.classpath"/>
                                    <compilerarg value="-implicit:none"/>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.graphics.modulepath}"/>
                                    <compilerarg value="--add-modules=javafx.graphics"/>
                                </javac>

                                <pathconvert property="jfx.jslc.prism.classpath">
                                    <path>
                                        <path refid="maven.compile.classpath"/>
                                        <pathelement location="${project.basedir}/src/jslc/resources"/>
                                        <pathelement location="${project.build.directory}/jsl-compilers/prism"/>
                                        <pathelement location="${project.basedir}/src/main/jsl-prism"/>
                                    </path>
                                </pathconvert>
                                <apply executable="${java.home}/bin/java" failonerror="true"
                                       dir="${project.basedir}" parallel="false">
                                    <arg value="-cp"/>
                                    <arg value="${jfx.jslc.prism.classpath}"/>
                                    <arg value="CompileJSL"/>
                                    <arg value="-i"/>
                                    <arg value="${project.basedir}/src/main/jsl-prism"/>
                                    <arg value="-o"/>
                                    <arg value="${jfx.graphics.gensrc}/jsl-prism"/>
                                    <arg value="-t"/>
                                    <arg value="-pkg"/>
                                    <arg value="com/sun/prism"/>
                                    <arg line="${jfx.jsl.backends}"/>
                                    <arg value="-name"/>
                                    <srcfile/>
                                    <fileset dir="${project.basedir}/src/main/jsl-prism" includes="**/*.jsl"/>
                                </apply>

                                <!-- Second pass: compile main + generated sources as the module,
                                     generating JNI headers for the native build -->
                                <mkdir dir="${project.build.directory}/mods"/>
                                <javac destdir="${project.build.directory}/mods"
                                       includeantruntime="false" encoding="UTF-8" debug="true"
                                       release="${jfx.jdk.target.version}" fork="true"
                                       sourcepath="" memorymaximumsize="2048m">
                                    <src path="${project.basedir}/src/main/java"/>
                                    <src path="${jfx.graphics.gensrc}/jsl-decora"/>
                                    <src path="${jfx.graphics.gensrc}/jsl-prism"/>
                                    <compilerarg value="-h"/>
                                    <compilerarg value="${jfx.graphics.gensrc}/headers"/>
                                    <compilerarg value="-implicit:none"/>
                                    <compilerarg value="--module-version"/>
                                    <compilerarg value="${jfx.release.version.short}"/>
                                    <compilerarg value="--module-source-path"/>
                                    <compilerarg value="javafx.graphics=${project.basedir}/src/main/java${path.separator}${jfx.graphics.gensrc}/jsl-decora${path.separator}${jfx.graphics.gensrc}/jsl-prism"/>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.root}/modules/javafx.base/target/classes"/>
                                    <compilerarg value="${jfx.lint}"/>
                                    <compilerarg value="${jfx.werror}"/>
                                    <compilerarg value="-Xmaxerrs"/>
                                    <compilerarg value="1000"/>
                                    <compilerarg value="-Xmaxwarns"/>
                                    <compilerarg value="1000"/>
                                </javac>
                                <copy todir="${project.build.outputDirectory}">
                                    <fileset dir="${project.build.directory}/mods/javafx.graphics"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Shader resources (fxc .obj, GLSL .frag, Metal .metallib) into the
                             module classes -->
                        <id>copy-shaders</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/native/shader-obj"/>
                                <copy todir="${project.build.outputDirectory}">
                                    <fileset dir="${project.build.directory}/native/shader-obj" includes="**/*.obj,**/*.metallib"/>
                                </copy>
                                <copy todir="${project.build.outputDirectory}">
                                    <fileset dir="${jfx.graphics.gensrc}/jsl-decora" includes="**/*.frag"/>
                                    <fileset dir="${jfx.graphics.gensrc}/jsl-prism" includes="**/*.frag"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-shims</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/shims"/>
                                <javac destdir="${project.build.directory}/shims"
                                       includeantruntime="false" encoding="UTF-8" debug="true"
                                       release="${jfx.jdk.target.version}" fork="true"
                                       sourcepath="" memorymaximumsize="2048m">
                                    <src path="${project.basedir}/src/main/java"/>
                                    <src path="${project.basedir}/src/shims/java"/>
                                    <src path="${jfx.graphics.gensrc}/jsl-decora"/>
                                    <src path="${jfx.graphics.gensrc}/jsl-prism"/>
                                    <compilerarg value="-implicit:none"/>
                                    <compilerarg value="--module-version"/>
                                    <compilerarg value="${jfx.release.version.short}"/>
                                    <compilerarg value="--module-source-path"/>
                                    <compilerarg value="javafx.graphics=${project.basedir}/src/main/java${path.separator}${project.basedir}/src/shims/java${path.separator}${jfx.graphics.gensrc}/jsl-decora${path.separator}${jfx.graphics.gensrc}/jsl-prism"/>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.shims.base}"/>
                                    <compilerarg value="${jfx.test.lint}"/>
                                    <!-- Gradle parity: the shims were compiled with
                                         TEST_JAVAC_WERROR, which defaulted to true.
                                         The module lint has to be switched off first,
                                         exactly as jfx.lint does for the main compile.
                                         This javac sees only the javafx.base shim on
                                         its module path, so every qualified export in
                                         module-info.java to javafx.controls, media,
                                         swing or web reports "module not found" and
                                         those 65 warnings would fail the build. -->
                                    <compilerarg value="-Xlint:-module"/>
                                    <compilerarg value="${jfx.werror}"/>
                                    <compilerarg value="-Xmaxerrs"/>
                                    <compilerarg value="1000"/>
                                    <compilerarg value="-Xmaxwarns"/>
                                    <compilerarg value="1000"/>
                                </javac>
                                <!-- module resources + compiled shaders for test runtime -->
                                <copy todir="${jfx.shims.graphics}">
                                    <fileset dir="${project.build.outputDirectory}" excludes="**/*.class"/>
                                </copy>
                                <copy todir="${jfx.shims.graphics}">
                                    <fileset dir="${project.build.directory}/native/shader-obj" includes="**/*.obj,**/*.metallib"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!-- Platform-specific jar excludes (mirroring the Gradle
                     buildModuleClasses excludes) live in the jar-excludes-win,
                     jar-excludes-linux and jar-excludes-mac profiles below.
                     The conditional jar-excludes-*-noes2 and jar-excludes-nonull3d
                     profiles append further patterns to those lists and therefore
                     have to stay declared after the profile they extend. -->
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <skipIfEmpty>true</skipIfEmpty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --upgrade-module-path "${jfx.shims.base}${path.separator}${jfx.shims.graphics}"
                        --add-modules javafx.base,javafx.graphics
                        @${project.basedir}/src/test/addExports
                        @${jfx.root}/buildtools/addExports
                        --enable-native-access=javafx.graphics
                        -Djava.library.path=${project.build.directory}/native/bin
                        ${jfx.headless.args}
                    </argLine>
                    <systemPropertyVariables>
                        <javafx.toolkit>test.com.sun.javafx.pgstub.StubToolkit</javafx.toolkit>
                        <CSS_META_DATA_TEST_DIR>${jfx.shims.graphics}/javafx</CSS_META_DATA_TEST_DIR>
                        <unstable.test>${UNSTABLE_TEST}</unstable.test>
                        <test.screenshot>${TEST_SCREENSHOT}</test.screenshot>
                        <junit.jupiter.execution.timeout.test.method.default>${junit.test.timeout}s</junit.jupiter.execution.timeout.test.method.default>
                        <junit.jupiter.execution.timeout.lifecycle.method.default>${junit.lifecycle.timeout}s</junit.jupiter.execution.timeout.lifecycle.method.default>
                        <javafx.enablePreview>true</javafx.enablePreview>
                        <javafx.suppressPreviewWarning>true</javafx.suppressPreviewWarning>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Platform-specific module jar contents, mirroring the Gradle
             buildModuleClasses excludes for each platform. -->
        <profile>
            <id>jar-excludes-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>version.rc</exclude>
                                <exclude>com/sun/glass/ui/swt/**</exclude>
                                <exclude>com/sun/javafx/tools/ant/**</exclude>
                                <exclude>com/javafx/main/**</exclude>
                                <exclude>com/sun/javafx/webkit/drt/**</exclude>
                                <exclude>com/sun/prism/es2/MacGL*</exclude>
                                <exclude>com/sun/glass/events/mac/**</exclude>
                                <exclude>com/sun/glass/ui/mac/**</exclude>
                                <exclude>com/sun/prism/mtl/**</exclude>
                                <exclude>com/sun/scenario/effect/impl/hw/mtl/**</exclude>
                                <exclude>com/sun/glass/ui/gtk/**</exclude>
                                <exclude>com/sun/prism/es2/EGL*</exclude>
                                <exclude>com/sun/prism/es2/X11GL*</exclude>
                                <exclude>com/sun/glass/ui/monocle/**</exclude>
                                <exclude>com/sun/prism/es2/Monocle*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Gradle parity: the ES2 pipeline classes are only dropped when
             INCLUDE_ES2 is off (the default on Windows); with -DINCLUDE_ES2=true
             the native-win profile builds prism_es2.dll and the classes must
             stay in the jar. This profile must be declared after
             jar-excludes-win: it is injected later, so combine.children="append"
             adds these two patterns to that profile's <excludes> instead of
             replacing them. -->
        <profile>
            <id>jar-excludes-win-noes2</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes combine.children="append">
                                <exclude>com/sun/prism/es2/**</exclude>
                                <exclude>com/sun/scenario/effect/impl/es2/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jar-excludes-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>version.rc</exclude>
                                <exclude>com/sun/glass/ui/swt/**</exclude>
                                <exclude>com/sun/javafx/tools/ant/**</exclude>
                                <exclude>com/javafx/main/**</exclude>
                                <exclude>com/sun/javafx/webkit/drt/**</exclude>
                                <exclude>**/*.hlsl</exclude>
                                <exclude>com/sun/glass/ui/win/**</exclude>
                                <exclude>com/sun/prism/d3d/**</exclude>
                                <exclude>com/sun/prism/es2/WinGL*</exclude>
                                <exclude>com/sun/scenario/effect/impl/hw/d3d/**</exclude>
                                <exclude>com/sun/prism/es2/MacGL*</exclude>
                                <exclude>com/sun/glass/events/mac/**</exclude>
                                <exclude>com/sun/glass/ui/mac/**</exclude>
                                <exclude>com/sun/prism/mtl/**</exclude>
                                <exclude>com/sun/scenario/effect/impl/hw/mtl/**</exclude>
                                <exclude>com/sun/prism/es2/EGL*</exclude>
                                <!-- com/sun/glass/ui/monocle/** and com/sun/prism/es2/Monocle* ship in
                                     the Linux jar: Monocle is pure Java (its JNI became FFM bindings);
                                     Windows and macOS keep excluding it -->
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Gradle parity: INCLUDE_ES2 defaults to true on Linux, so the ES2
             pipeline classes are only dropped when it is explicitly turned off,
             which is what the old build did with "if (!IS_INCLUDE_ES2) exclude".
             Profile activation never sees POM properties, only ones set on the
             command line, so this matches the literal value "false" instead of
             the !true form used by the Windows profile above, where the default
             is off. Declared after jar-excludes-linux so that the append
             combiner adds these patterns to that exclude list. -->
        <profile>
            <id>jar-excludes-linux-noes2</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>false</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes combine.children="append">
                                <exclude>com/sun/prism/es2/**</exclude>
                                <exclude>com/sun/scenario/effect/impl/es2/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jar-excludes-mac</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>version.rc</exclude>
                                <exclude>com/sun/glass/ui/swt/**</exclude>
                                <exclude>com/sun/javafx/tools/ant/**</exclude>
                                <exclude>com/javafx/main/**</exclude>
                                <exclude>com/sun/javafx/webkit/drt/**</exclude>
                                <exclude>**/*.hlsl</exclude>
                                <exclude>com/sun/glass/ui/win/**</exclude>
                                <exclude>com/sun/prism/d3d/**</exclude>
                                <exclude>com/sun/prism/es2/WinGL*</exclude>
                                <exclude>com/sun/scenario/effect/impl/hw/d3d/**</exclude>
                                <exclude>com/sun/glass/ui/gtk/**</exclude>
                                <exclude>com/sun/prism/es2/EGL*</exclude>
                                <exclude>com/sun/prism/es2/X11GL*</exclude>
                                <exclude>com/sun/glass/ui/monocle/**</exclude>
                                <exclude>com/sun/prism/es2/Monocle*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Same reasoning as jar-excludes-linux-noes2: INCLUDE_ES2 defaults to
             true on macOS, so the ES2 pipeline classes are only dropped when it
             is explicitly set to false. Declared after jar-excludes-mac so that
             the append combiner adds to that exclude list. -->
        <profile>
            <id>jar-excludes-mac-noes2</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>false</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes combine.children="append">
                                <exclude>com/sun/prism/es2/**</exclude>
                                <exclude>com/sun/scenario/effect/impl/es2/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Gradle parity: the Null3D pipeline is a perf debugging aid that only
             ships when INCLUDE_NULL3D is true; the old build defaulted that
             property to false and gated the exclude on it. Null3D is pure Java
             with no native library, is not named in module-info.java and is not
             referenced from any source outside com/sun/prism/null3d, so leaving
             it out of the jar is safe. One profile covers every platform and is
             declared last so that the append combiner adds to whichever
             jar-excludes profile matched the host OS. -->
        <profile>
            <id>jar-excludes-nonull3d</id>
            <activation>
                <property>
                    <name>INCLUDE_NULL3D</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes combine.children="append">
                                <exclude>com/sun/prism/null3d/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JSLC hardware shader backends, mirroring the Gradle addJSL/generateShaders
             argument list: -d3d on Windows, -mtl on macOS, -es2 on Linux or when
             INCLUDE_ES2 is set. The default (-es2) is declared in <properties> and
             is what Linux always uses, because Gradle emitted -es2 for IS_LINUX
             regardless of INCLUDE_ES2. The profiles below are mutually exclusive
             per OS and their activation values are matched literally, so use
             exactly -DINCLUDE_ES2=true or -DINCLUDE_ES2=false. The values are
             deliberately asymmetric because INCLUDE_ES2 is off by default on
             Windows and on by default on macOS, and profile activation only ever
             sees properties set on the command line, never the POM property that
             the root pom sets per platform. -->
        <profile>
            <id>jsl-backends-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>!true</value>
                </property>
            </activation>
            <properties>
                <jfx.jsl.backends>-d3d</jfx.jsl.backends>
            </properties>
        </profile>
        <!-- Mutually exclusive with jsl-backends-win: with -DINCLUDE_ES2=true the
             native-win profile builds prism_es2.dll, so the GLSL shaders are needed. -->
        <profile>
            <id>jsl-backends-win-es2</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <jfx.jsl.backends>-d3d -es2</jfx.jsl.backends>
            </properties>
        </profile>
        <profile>
            <id>jsl-backends-mac</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>!false</value>
                </property>
            </activation>
            <properties>
                <jfx.jsl.backends>-mtl -es2</jfx.jsl.backends>
            </properties>
        </profile>
        <!-- Mutually exclusive with jsl-backends-mac: with -DINCLUDE_ES2=false the
             native-mac profile skips libprism_es2.dylib and jar-excludes-mac-noes2
             drops the ES2 classes, so the GLSL shaders are not needed either. -->
        <profile>
            <id>jsl-backends-mac-noes2</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
                <property>
                    <name>INCLUDE_ES2</name>
                    <value>false</value>
                </property>
            </activation>
            <properties>
                <jfx.jsl.backends>-mtl</jfx.jsl.backends>
            </properties>
        </profile>
        <!-- Native Windows libraries via CMake + Visual Studio. Skip with -DskipNative=true -->
        <profile>
            <id>native-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>skipNative</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}/native</argument>
                                        <argument>-B</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>-A</argument>
                                        <argument>x64</argument>
                                        <argument>-DJDK_HOME=${java.home}</argument>
                                        <argument>-DGENSRC_DIR=${jfx.graphics.gensrc}</argument>
                                        <argument>-DHEADERS_DIR=${jfx.graphics.gensrc}/headers/javafx.graphics</argument>
                                        <argument>-DBIN_DIR=${project.build.directory}/native/bin</argument>
                                        <argument>-DSHADER_OBJ_DIR=${project.build.directory}/native/shader-obj</argument>
                                        <argument>-DINCLUDE_ES2=${INCLUDE_ES2}</argument>
                                        <argument>-DJFX_VER=${jfx.release.version}</argument>
                                        <argument>-DJFX_FVER=${jfx.release.major.version},${jfx.release.minor.version},${jfx.release.security.version},${jfx.release.patch.version}</argument>
                                        <argument>-DJFX_BUILD_ID=${jfx.release.version.long}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>--config</argument>
                                        <argument>${CONF}</argument>
                                        <argument>--parallel</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Native Linux libraries via CMake + make/gcc. Skip with -DskipNative=true -->
        <profile>
            <id>native-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
                <property>
                    <name>skipNative</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}/native</argument>
                                        <argument>-B</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=${CONF}</argument>
                                        <argument>-DJDK_HOME=${java.home}</argument>
                                        <argument>-DGENSRC_DIR=${jfx.graphics.gensrc}</argument>
                                        <argument>-DHEADERS_DIR=${jfx.graphics.gensrc}/headers/javafx.graphics</argument>
                                        <argument>-DBIN_DIR=${project.build.directory}/native/bin</argument>
                                        <argument>-DINCLUDE_ES2=${INCLUDE_ES2}</argument>
                                        <argument>-DINCLUDE_ES2_MONOCLE=${INCLUDE_ES2_MONOCLE}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>--parallel</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Native macOS libraries and Metal shader library via CMake + clang and the
             xcrun metal/metallib tools. Skip with -DskipNative=true -->
        <profile>
            <id>native-mac</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
                <property>
                    <name>skipNative</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}/native</argument>
                                        <argument>-B</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=${CONF}</argument>
                                        <argument>-DJDK_HOME=${java.home}</argument>
                                        <argument>-DGENSRC_DIR=${jfx.graphics.gensrc}</argument>
                                        <argument>-DHEADERS_DIR=${jfx.graphics.gensrc}/headers/javafx.graphics</argument>
                                        <argument>-DBIN_DIR=${project.build.directory}/native/bin</argument>
                                        <argument>-DSHADER_OBJ_DIR=${project.build.directory}/native/shader-obj</argument>
                                        <argument>-DINCLUDE_ES2=${INCLUDE_ES2}</argument>
                                        <argument>-DMSL_VERSION=${jfx.msl.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>--parallel</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
