<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx</artifactId>
        <version>28-ea</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>javafx-web</artifactId>
    <name>javafx-web</name>
    <description>JavaFX web module (javafx.web)</description>

    <!-- The WebKit native library (jfxwebkit) is only built with COMPILE_WEBKIT=true
         in the Gradle build (perl + cmake + ninja + clang toolchain) and is not
         ported to Maven; a prebuilt jfxwebkit library from an OpenJFX SDK can be
         used at runtime instead. Web tests need that native library, so they are
         compiled but skipped unless -Djfx.web.skipTests=false is passed and the
         library is available on java.library.path. -->

    <properties>
        <jfx.web.skipTests>true</jfx.web.skipTests>
        <!-- The FFM binding tests are a separate surefire execution: they run
             against the wkjstub recording stub built from src/test/native/wkjstub,
             not against jfxwebkit, so they need neither a prebuilt WebKit nor
             -Djfx.web.skipTests=false and they run in the default build. Turn
             them off with -Djfx.web.skipFfmTests=true, which also skips building
             the stub; -DskipNative=true skips the stub build on its own, and the
             tests then skip themselves through their library-availability
             assumption. -->
        <jfx.web.skipFfmTests>false</jfx.web.skipFfmTests>
        <jfx.web.stub.bindir>${project.build.directory}/native/bin</jfx.web.stub.bindir>
        <!-- The "release NN" option cannot be combined with upgrade-module-path
             (needed to override the deprecated-for-removal system jdk.jsobject with
             this repository's copy), so -source/-target are used instead and the
             resulting implicit "options" lint warning is disabled. -->
        <jfx.lint>-Xlint:removal,missing-explicit-ctor,-module,-options</jfx.lint>
        <jfx.web.modulepath.extra>${jfx.root}/modules/javafx.media/target/classes${path.separator}${jfx.root}/modules/jdk.jsobject/target/classes</jfx.web.modulepath.extra>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>jdk-jsobject</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${jfx.shims.base}</directory>
                <excludes>
                    <exclude>module-info.class</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>${jfx.shims.web}</directory>
                <excludes>
                    <exclude>module-info.class</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The pre-generated DOM binding wrappers live in the native
                             source tree and are compiled as part of the module -->
                        <id>copy-dom-wrappers</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.directory}/gensrc/java">
                                    <fileset dir="${project.basedir}/src/main/native/Source/WebCore/bindings/java/dom3/java"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-shims</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${jfx.shims.web}"/>
                                <javac destdir="${jfx.shims.web}" includeantruntime="false"
                                       encoding="UTF-8" debug="true" fork="true" sourcepath=""
                                       source="${jfx.jdk.target.version}" target="${jfx.jdk.target.version}"
                                       memorymaximumsize="2048m">
                                    <src path="${project.basedir}/src/main/java"/>
                                    <src path="${project.build.directory}/gensrc/java"/>
                                    <src path="${project.basedir}/src/shims/java"/>
                                    <compilerarg value="-implicit:none"/>
                                    <compilerarg value="-Xlint:-options"/>
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${jfx.shims.base}${path.separator}${jfx.shims.graphics}${path.separator}${jfx.shims.controls}${path.separator}${jfx.root}/modules/javafx.media/target/classes"/>
                                    <compilerarg value="--upgrade-module-path"/>
                                    <compilerarg value="${jfx.root}/modules/jdk.jsobject/target/classes"/>
                                    <compilerarg value="--module-version"/>
                                    <compilerarg value="${jfx.release.version.short}"/>
                                    <compilerarg value="${jfx.test.lint}"/>
                                    <!-- Gradle parity: the shims were compiled with TEST_JAVAC_WERROR,
                                         which defaulted to true. The module lint has to be switched
                                         off first, exactly as jfx.lint does for the main compile:
                                         this javac sees only part of the module graph, so every
                                         qualified export in module-info.java to a module that is not
                                         on its module path reports "module not found". -->
                                    <compilerarg value="-Xlint:-module"/>
                                    <compilerarg value="${jfx.werror}"/>
                                    <compilerarg value="-Xmaxerrs"/>
                                    <compilerarg value="1000"/>
                                    <compilerarg value="-Xmaxwarns"/>
                                    <compilerarg value="1000"/>
                                </javac>
                                <copy todir="${jfx.shims.web}">
                                    <fileset dir="${project.build.outputDirectory}" excludes="**/*.class"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Jar of archive-*.* test resources used by WebEngine load tests -->
                        <id>test-web-archive-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/testing/resources"/>
                                <jar destfile="${project.build.directory}/testing/resources/webArchiveJar.jar">
                                    <fileset dir="${project.basedir}/src/test/resources/test/html"
                                             includes="archive-*.*"/>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-gensrc</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/gensrc/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release combine.self="override"/>
                    <source>${jfx.jdk.target.version}</source>
                    <target>${jfx.jdk.target.version}</target>
                    <compilerArgs combine.children="append">
                        <arg>--module-version</arg>
                        <arg>${jfx.release.version.short}</arg>
                        <!-- Resolve requires jdk.jsobject against this repository's copy
                             rather than the deprecated-for-removal JDK system module -->
                        <arg>--upgrade-module-path</arg>
                        <arg>${jfx.root}/modules/jdk.jsobject/target/classes</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <!-- Gradle parity: the DumpRenderTree harness is non-shipping
                                 code and was excluded from the module jar on every
                                 platform (buildModuleClasses excluded
                                 "com/sun/javafx/webkit/drt"). Scoped to the module jar:
                                 the Gradle shims class dir, whose Maven equivalent is the
                                 tests jar below, did contain those classes. -->
                            <excludes>
                                <exclude>com/sun/javafx/webkit/drt/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <skipIfEmpty>true</skipIfEmpty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The module tests, which need a prebuilt jfxwebkit. The
                             FFM binding tests are tagged "ffm" and excluded here;
                             they run in the execution below against wkjstub. -->
                        <id>default-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>${jfx.web.skipTests}</skipTests>
                            <excludedGroups>ffm</excludedGroups>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- FFM binding tests: same module configuration, but the
                             wkjstub output directory is first on java.library.path
                             and WebKitNative is pointed at the stub by name, so no
                             jfxwebkit is loaded and nothing collides with one. -->
                        <id>ffm-binding-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>${jfx.web.skipFfmTests}</skipTests>
                            <groups>ffm</groups>
                            <argLine>
                                --upgrade-module-path "${jfx.shims.base}${path.separator}${jfx.shims.graphics}${path.separator}${jfx.shims.controls}${path.separator}${jfx.web.modulepath.extra}${path.separator}${jfx.shims.web}"
                                --add-modules javafx.base,javafx.graphics,javafx.controls,javafx.media,jdk.jsobject,javafx.web
                                @${project.basedir}/src/test/addExports
                                @${jfx.root}/buildtools/addExports
                                --enable-native-access=javafx.graphics,javafx.media,javafx.web
                                "-Djava.library.path=${jfx.web.stub.bindir}${path.separator}${jfx.native.librarypath}"
                                -Djavafx.web.nativeLibrary=wkjstub
                                -Djfx.web.dom.abi.spec=${jfx.root}/buildtools/ffm-web/dom-abi.tsv
                                -Djfx.web.page.abi.header=${project.basedir}/src/main/native/Source/WebKitLegacy/java/api/webkit_java_api_page.h
                                -DWEB_ARCHIVE_JAR_TEST_DIR=${project.build.directory}/testing/resources
                            </argLine>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <argLine>
                        --upgrade-module-path "${jfx.shims.base}${path.separator}${jfx.shims.graphics}${path.separator}${jfx.shims.controls}${path.separator}${jfx.web.modulepath.extra}${path.separator}${jfx.shims.web}"
                        --add-modules javafx.base,javafx.graphics,javafx.controls,javafx.media,jdk.jsobject,javafx.web
                        @${project.basedir}/src/test/addExports
                        @${jfx.root}/buildtools/addExports
                        --enable-native-access=javafx.graphics,javafx.media,javafx.web
                        "-Djava.library.path=${jfx.native.librarypath}"
                        -DWEB_ARCHIVE_JAR_TEST_DIR=${project.build.directory}/testing/resources
                    </argLine>
                    <systemPropertyVariables>
                        <glass.platform>Headless</glass.platform>
                        <prism.order>sw</prism.order>
                        <unstable.test>${UNSTABLE_TEST}</unstable.test>
                        <test.screenshot>${TEST_SCREENSHOT}</test.screenshot>
                        <junit.jupiter.execution.timeout.test.method.default>${junit.test.timeout}s</junit.jupiter.execution.timeout.test.method.default>
                        <junit.jupiter.execution.timeout.lifecycle.method.default>${junit.lifecycle.timeout}s</junit.jupiter.execution.timeout.lifecycle.method.default>
                        <javafx.enablePreview>true</javafx.enablePreview>
                        <javafx.suppressPreviewWarning>true</javafx.suppressPreviewWarning>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- The wkjstub test library: a generated recording implementation of the
         whole wkj_* C ABI (src/test/native/wkjstub). It is what makes the FFM
         binding layer executable here, since this build cannot compile WebKit
         (FFM-ABI-CONTRACT.md section 8). It is test-only: it is never packaged,
         never installed, and is named wkjstub rather than jfxwebkit so that it
         cannot be confused with, or shadow, a real WebKit library. -->
    <profiles>
        <!-- -DskipTests must skip these too. The ffm-binding-test execution sets
             its own <skipTests>, which takes precedence over the command line, so
             the flag has to arrive as a property instead. -->
        <profile>
            <id>web-ffm-tests-skipped</id>
            <activation>
                <property>
                    <name>skipTests</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <jfx.web.skipFfmTests>true</jfx.web.skipFfmTests>
            </properties>
        </profile>
        <profile>
            <id>web-stub-native-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>skipNative</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>wkjstub-cmake-configure</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${jfx.web.skipFfmTests}</skip>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}/src/test/native/wkjstub</argument>
                                        <argument>-B</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>-A</argument>
                                        <argument>x64</argument>
                                        <argument>-DJFX_ROOT=${jfx.root}</argument>
                                        <argument>-DBIN_DIR=${jfx.web.stub.bindir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>wkjstub-cmake-build</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${jfx.web.skipFfmTests}</skip>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>--config</argument>
                                        <argument>${CONF}</argument>
                                        <argument>--parallel</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>web-stub-native-unix</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
                <property>
                    <name>skipNative</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>wkjstub-cmake-configure</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${jfx.web.skipFfmTests}</skip>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}/src/test/native/wkjstub</argument>
                                        <argument>-B</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>-DJFX_ROOT=${jfx.root}</argument>
                                        <argument>-DBIN_DIR=${jfx.web.stub.bindir}</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=${CONF}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>wkjstub-cmake-build</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${jfx.web.skipFfmTests}</skip>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${project.build.directory}/native/cmake</argument>
                                        <argument>--parallel</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
