                                        <resource>
                                            <directory>${project.basedir}/modules/jfx.incubator.richtext/src/main/docs</directory>
                                            <targetPath>jfx.incubator.richtext</targetPath>
                                            <filtering>false</filtering>
                                            <excludes><exclude>**/*.html</exclude></excludes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
